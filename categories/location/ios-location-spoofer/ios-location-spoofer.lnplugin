#!name=定位助手（无状态）
#!desc=在 Loon 内填写纬度和经度即可使用。坐标只写入本机；首次使用需开启 HTTPS 解密并安装/信任 Loon CA 证书。不需要 Cloudflare。
#!homepage=https://github.com/Lxp1986/loon-plugins/tree/main/categories/location/ios-location-spoofer
#!icon=https://raw.githubusercontent.com/Lxp1986/loon-plugins/main/categories/location/ios-location-spoofer/assets/icon.svg
#!input = 纬度
#!input = 经度
#!select = 启用,false,true

# 在 Loon 插件详情页的配置项中直接填写纬度、经度，选择启用=true 即可启用。
# 不需要打开网页，也不需要 Cloudflare；Loon 会把这些配置项写入本机存储，脚本自动读取。
# 恢复真实定位：把启用选择为 false，或清空坐标后刷新插件。
# %APPEND% 用于把本插件的 MITM 主机追加到现有配置，避免覆盖已有主机名。

[Script]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Lxp1986/loon-plugins/main/categories/location/ios-location-spoofer/scripts/location-spoofer.js, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=12, tag=定位替换, argument=mode=response&debug=false
http-request ^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/ils-settings\/ script-path=https://raw.githubusercontent.com/Lxp1986/loon-plugins/main/categories/location/ios-location-spoofer/scripts/location-settings.js, requires-body=false, timeout=10, tag=保存定位

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
