#!name=iOS Location Spoofer (Stateless)
#!desc=无状态 Loon 插件：坐标只写入本机。首次使用只需导入插件、开启 HTTPS 解密并安装/信任 Loon CA 证书，再打开 beginner 安装向导；不需要 Cloudflare。
#!homepage=https://github.com/cyberhandyman/ios-location-spoofer

# 无状态版不使用 configUrl / 远程同步，也不在插件 UI 里填经纬度。
# 选点、切换、清除全部通过选点页完成（写入本机 $persistentStore）。
# 未选点时 enabled 默认为 false，脚本直接放行真实定位。
# %APPEND% 用于把本插件的 MITM 主机追加到现有配置，避免覆盖已有主机名。

[Script]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Lxp1986/ios-location-spoofer/main/location-spoofer.js, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=12, tag=iOS Location Spoofer, argument=mode=response&debug=false
http-request ^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/ils-settings\/ script-path=https://raw.githubusercontent.com/Lxp1986/ios-location-spoofer/main/location-settings.js, requires-body=false, timeout=10, tag=iLS Settings

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
