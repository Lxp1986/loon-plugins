#!name=定位助手（无状态）
#!desc=在 Loon 内填写纬度和经度即可使用。坐标只写入本机；首次使用需开启 HTTPS 解密并安装/信任 Loon CA 证书。不需要 Cloudflare。
#!homepage=https://github.com/Lxp1986/loon-plugins/tree/main/categories/location/ios-location-spoofer
#!icon=https://raw.githubusercontent.com/Lxp1986/loon-plugins/main/categories/location/ios-location-spoofer/assets/icon.svg
#!loon_version = 3.5.1(983)

[Argument]
latitude = input,"",tag=纬度,desc=目标纬度，如：39.9042（留空则用已保存坐标）
longitude = input,"",tag=经度,desc=目标经度，如：116.4074（留空则用已保存坐标）
altitude = input,"",tag=海拔,desc=目标海拔（米），留空则用已保存值
enabled = switch,false,tag=启用,desc=打开后替换系统网络定位，关闭恢复真实定位

# 在 Loon 插件详情页的配置项中直接填写纬度、经度、海拔，打开「启用」开关即可。
# 不需要打开网页，也不需要 Cloudflare；参数直接传给脚本，也可经由地图选点页写入本机存储。
# 恢复真实定位：把「启用」开关关闭，或清空坐标后刷新插件。
# %APPEND% 用于把本插件的 MITM 主机追加到现有配置，避免覆盖已有主机名。

[Script]
response if ${url} ~= /^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$/ then script("https://raw.githubusercontent.com/Lxp1986/loon-plugins/main/categories/location/ios-location-spoofer/scripts/location-spoofer.js", {${latitude}, ${longitude}, ${altitude}, ${enabled}}) with tag="定位替换", timeout=12, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/ils-settings\// then script("https://raw.githubusercontent.com/Lxp1986/loon-plugins/main/categories/location/ios-location-spoofer/scripts/location-settings.js") with tag="保存定位", timeout=10

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
